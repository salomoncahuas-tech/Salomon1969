+def _slug(texto):
+    """'San Miguel de El Faique' -> 'san_miguel_de_el_faique'."""
+    t = unicodedata.normalize("NFKD", str(texto or ""))
+    t = "".join(c for c in t if not unicodedata.combining(c)).lower()
+    return re.sub(r"[^a-z0-9]+", "_", t).strip("_")
