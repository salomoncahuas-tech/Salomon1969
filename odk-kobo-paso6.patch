+def utm_en_rango(este, norte):
+    try:
+        return (UTM_ESTE_MIN <= float(este) <= UTM_ESTE_MAX and
+                UTM_NORTE_MIN <= float(norte) <= UTM_NORTE_MAX)
+    except (TypeError, ValueError):
+        return False
