"CI3.3" target="CD3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="PC" target="ED1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="PC" target="ED2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="PC" target="ED3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED1" target="EI1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED3" target="EI1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI1" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED1" target="EI2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI2" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED2" target="EI3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI3" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED3" target="EI4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI4" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED2" target="EI5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED3" target="EI5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI5" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="morropon" name="Morropón"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1123" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Árbol de problemas – Provincia de Morropón — Buenos Aires, Chalaco, Chulucanas, Morropón, Salitral, San Juan de Bigote, Santa Catalina de Mossa, Santo Domingo y Yamango · 59 bloques · 7,327.37 ha (7,313.55 ha netas V8) · 79 centros poblados (9,537 hab.)" style="text;html=0;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#1B4D2E;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="43" y="24" width="1501" height="58" as="geometry"/></mxCell><mxCell id="EF" value="Incremento de los costos de reconstrucción y disminución de la resiliencia de la población de Morropón y sus medios de vida frente a huaicos, movimientos en masa e inundaciones desencadenados por lluvias extremas, intensificadas por el cambio climático" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#8C5A12;strokeColor=#8C5A12;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=20.7;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="328.4" y="100.8" width="930.6" height="84.0" as="geometry"/></mxCell><mxCell id="EI1" value="EI1  Daños a viviendas, colegios, vías, badenes y captaciones de agua en los centros poblados de cabecera" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="43.2" y="225.1" width="359.4" height="68.4" as="geometry"/></mxCell><mxCell id="EI2" value="EI2  Pérdida de suelo agrícola y de ingresos agropecuarios" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="423.7" y="225.1" width="359.4" height="68.4" as="geometry"/></mxCell><mxCell id="EI3" value="EI3  Inundación de parcelas, arrastre de ganado y aislamiento estacional de caseríos por la activación de quebradas" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="804.2" y="225.1" width="359.4" height="68.4" as="geometry"/></mxCell><mxCell id="EI4" value="EI4  Mayor aporte de sedimentos al río Piura y pérdida de otros servicios del bosque seco (fuentes de agua, hábitat, carbono)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1184.8" y="225.1" width="359.4" height="68.4" as="geometry"/></mxCell><mxCell id="ED1" value="ED1  Mayor ocurrencia de huaicos y movimientos en masa (caídas de bloques, derrumbes, deslizamientos) en quebradas, taludes y frentes rocosos" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F6E7C8;strokeColor=#B8862B;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.3;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="43.2" y="333.8" width="486.2" height="72.0" as="geometry"/></mxCell><mxCell id="ED2" value="ED2  Erosión hídrica laminar y en cárcavas, con pérdida acelerada de suelo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F6E7C8;strokeColor=#B8862B;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.3;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="550.6" y="333.8" width="486.2" height="72.0" as="geometry"/></mxCell><mxCell id="ED3" value="ED3  Mayor escorrentía torrencial y transporte de sedimentos que activan las quebradas desde las zonas de origen" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F6E7C8;strokeColor=#B8862B;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.3;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1057.9" y="333.8" width="486.2" height="72.0" as="geometry"/></mxCell><mxCell id="PC" value="La población de la provincia de Morropón no accede adecuadamente al servicio ecosistémico de regulación de riesgos naturales por la degradación del bosque estacionalmente seco de colina y montaña y del mosaico andino en las zonas de origen de huaicos, movimientos en masa e inundaciones" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1B4D2E;strokeColor=#1B4D2E;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=22.7;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="448.5" y="449.0" width="690.4" height="177.6" as="geometry"/></mxCell><mxCell id="EX1" value="Factores condicionantes del peligro
Pendiente media 34.7 % (49.6 % en el mosaico andino); susceptibilidad litológica a movimientos en masa alta o muy alta en 42 bloques (Complejo de Olmos, Fm. Río Seco, Fm. La Bocana)." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6B7A70;strokeWidth=1;fontColor=#5B6B61;fontFamily=Arial;fontSize=14.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="43.2" y="449.0" width="371.7" height="177.6" as="geometry"/></mxCell><mxCell id="EX2" value="Factor desencadenante y cambio climático
Lluvias de El Niño 1983 (×3.71), 1998 (×3.75), 2017 (×2.97) y 2023 (×3.36) la media, hasta ×6.1 en M27B1; 15 de 45 años con menos de la mitad de la media; Tmáx +0.19 °C por década." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6B7A70;strokeWidth=1;fontColor=#5B6B61;fontFamily=Arial;fontSize=14.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1172.5" y="449.0" width="371.7" height="177.6" as="geometry"/></mxCell><mxCell id="CD1" value="CD1  Degradación de la cobertura vegetal protectora en las zonas de origen" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0EA;strokeColor=#1B4D2E;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.3;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="43.2" y="669.8" width="486.2" height="52.8" as="geometry"/></mxCell><mxCell id="CD2" value="CD2  Reducida capacidad de los suelos y laderas para controlar la erosión y la escorrentía" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0EA;strokeColor=#1B4D2E;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.3;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="550.6" y="669.8" width="486.2" height="52.8" as="geometry"/></mxCell><mxCell id="CD3" value="CD3  Inadecuada gobernanza y gestión local del ecosistema y del riesgo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0EA;strokeColor=#1B4D2E;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.3;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1057.9" y="669.8" width="486.2" height="52.8" as="geometry"/></mxCell><mxCell id="CI1.1" value="CI1.1  Sobrepastoreo caprino y vacuno sin manejo, que impide la regeneración del bosque seco" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="743.8" width="457.4" height="47.2" as="geometry"/></mxCell><mxCell id="CI1.2" value="CI1.2  Tala comercial de palo santo y extracción de madera y leña de especies del bosque seco" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="803.4" width="457.4" height="66.0" as="geometry"/></mxCell><mxCell id="CI1.3" value="CI1.3  Expansión agrícola y ocupación urbana de laderas y cauces" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="881.9" width="457.4" height="47.2" as="geometry"/></mxCell><mxCell id="CI1.4" value="CI1.4  Baja capacidad de regeneración natural del bosque seco por aridez extrema, sequías recurrentes y quemas" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="941.6" width="457.4" height="47.2" as="geometry"/></mxCell><mxCell id="CI2.1" value="CI2.1  Senderos de ganado y pisoteo que compactan el suelo y concentran la escorrentía" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="579.4" y="743.8" width="457.4" height="47.2" as="geometry"/></mxCell><mxCell id="CI2.2" value="CI2.2  Trochas, vías y canteras con cortes de talud sin drenaje ni estabilización" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="579.4" y="803.4" width="457.4" height="66.0" as="geometry"/></mxCell><mxCell id="CI2.3" value="CI2.3  Cárcavas activas y erosión laminar sin prácticas de conservación ni control" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="579.4" y="881.9" width="457.4" height="47.2" as="geometry"/></mxCell><mxCell id="CI3.1" value="CI3.1  Limitado conocimiento y organización comunal para el manejo del ecosistema y la gestión del riesgo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1086.7" y="743.8" width="457.4" height="47.2" as="geometry"/></mxCell><mxCell id="CI3.2" value="CI3.2  Limitada gobernanza de las entidades públicas y privadas: sin concertación, débil control forestal y sin mecanismos de retribución" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1086.7" y="803.4" width="457.4" height="66.0" as="geometry"/></mxCell><mxCell id="CI3.3" value="CI3.3  Tierras sin registro, de dominio estatal o comunal, y conflictos de linderos y de uso de pastos" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=15.7;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1086.7" y="881.9" width="457.4" height="47.2" as="geometry"/></mxCell><mxCell id="e0" style="endArrow=block;dashed