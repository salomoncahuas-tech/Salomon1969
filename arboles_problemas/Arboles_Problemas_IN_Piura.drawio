y relative="1" as="geometry"/></mxCell><mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED3" target="EI3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI3" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED2" target="EI4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED3" target="EI4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI4" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="huancabamba" name="Huancabamba"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1123" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Árbol de problemas – Provincia de Huancabamba — Canchaque, Huancabamba, Huarmaca, Lalaquiz y San Miguel de El Faique · 48 bloques · 3,452.21 ha netas (V8) · 58 centros poblados (6,573 hab., Censo 2017)" style="text;html=0;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#1B4D2E;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="43" y="24" width="1501" height="58" as="geometry"/></mxCell><mxCell id="EF" value="Incremento de los costos de reconstrucción y disminución de la resiliencia de la población de Huancabamba y sus medios de vida frente a movimientos en masa e inundaciones desencadenados por lluvias extremas, intensificadas por el cambio climático" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#8C5A12;strokeColor=#8C5A12;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=21.7;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="328.4" y="100.8" width="930.6" height="113.6" as="geometry"/></mxCell><mxCell id="EI1" value="EI1  Interrupción de vías y aislamiento estacional de caseríos, con pérdida de cosechas de café que no llegan al mercado" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.0;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="43.2" y="254.7" width="359.4" height="70.8" as="geometry"/></mxCell><mxCell id="EI2" value="EI2  Daños a viviendas, parcelas, ganado, captaciones y líneas de conducción de agua" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.0;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="423.7" y="254.7" width="359.4" height="70.8" as="geometry"/></mxCell><mxCell id="EI3" value="EI3  Pérdida de suelo agrícola y de productividad de la economía cafetalera y de subsistencia" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.0;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="804.2" y="254.7" width="359.4" height="70.8" as="geometry"/></mxCell><mxCell id="EI4" value="EI4  Aporte de sedimentos que deteriora quebradas y fuentes de agua, y pérdida de otros servicios del ecosistema" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.0;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1184.8" y="254.7" width="359.4" height="70.8" as="geometry"/></mxCell><mxCell id="ED1" value="ED1  Mayor ocurrencia de movimientos en masa (deslizamientos, derrumbes, reptación y flujos de detritos) en laderas y quebradas de cabecera" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F6E7C8;strokeColor=#B8862B;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="43.2" y="365.8" width="486.2" height="74.4" as="geometry"/></mxCell><mxCell id="ED2" value="ED2  Erosión hídrica acelerada y pérdida de suelo en laderas (surcos y cárcavas)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F6E7C8;strokeColor=#B8862B;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="550.6" y="365.8" width="486.2" height="74.4" as="geometry"/></mxCell><mxCell id="ED3" value="ED3  Mayor escorrentía torrencial y transporte de sedimentos desde las zonas de origen hacia las quebradas" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F6E7C8;strokeColor=#B8862B;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1057.9" y="365.8" width="486.2" height="74.4" as="geometry"/></mxCell><mxCell id="PC" value="La población de la provincia de Huancabamba no accede adecuadamente al servicio ecosistémico de regulación de riesgos naturales por la degradación del bosque estacionalmente seco, el matorral andino y los mosaicos agroforestales de ladera en las zonas de origen de movimientos en masa e inundaciones" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1B4D2E;strokeColor=#1B4D2E;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=23.3;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="448.5" y="483.4" width="690.4" height="182.4" as="geometry"/></mxCell><mxCell id="EX1" value="Factores condicionantes del peligro
Pendiente media 49 % (424.62 ha sobre 75 %; Canchaque 59.4 %); susceptibilidad litológica a movimientos en masa muy alta en 18 bloques y alta en 18 (Complejo de Olmos)." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6B7A70;strokeWidth=1;fontColor=#5B6B61;fontFamily=Arial;fontSize=15.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="43.2" y="483.4" width="371.7" height="182.4" as="geometry"/></mxCell><mxCell id="EX2" value="Factor desencadenante y cambio climático
Lluvias de El Niño 1983, 1998, 2017 y 2023 entre 2.0 y 2.7 veces la media provincial (3.2–3.3 veces en el bosque seco); tendencia +32.6 mm y +0.15 °C por década." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6B7A70;strokeWidth=1;fontColor=#5B6B61;fontFamily=Arial;fontSize=15.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1172.5" y="483.4" width="371.7" height="182.4" as="geometry"/></mxCell><mxCell id="CD1" value="CD1  Degradación de la cobertura vegetal protectora en las zonas de origen" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0EA;strokeColor=#1B4D2E;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="43.2" y="709.0" width="486.2" height="52.8" as="geometry"/></mxCell><mxCell id="CD2" value="CD2  Reducida capacidad de los suelos y laderas para controlar la erosión y la escorrentía" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0EA;strokeColor=#1B4D2E;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="550.6" y="709.0" width="486.2" height="52.8" as="geometry"/></mxCell><mxCell id="CD3" value="CD3  Inadecuada gobernanza y gestión local del ecosistema y del riesgo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0EA;strokeColor=#1B4D2E;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1057.9" y="709.0" width="486.2" height="52.8" as="geometry"/></mxCell><mxCell id="CI1.1" value="CI1.1  Sobrepastoreo caprino y vacuno sin manejo, que elimina la regeneración del bosque seco y del matorral" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="783.0" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI1.2" value="CI1.2  Cambio de uso hacia agricultura de ladera (café, maíz, pastos)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="844.2" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI1.3" value="CI1.3  Extracción de leña y madera y quemas para renovar pastos" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="905.5" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI1.4" value="CI1.4  Baja regeneración de especies nativas por aridez y avance de especies exóticas" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="966.8" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI2.1" value="CI2.1  Trochas, vías y cortes de talud sin drenaje ni estabilización" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="579.4" y="783.0" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI2.2" value="CI2.2  Laderas cultivadas sin prácticas de conservación y cárcavas sin control" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="579.4" y="844.2" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI2.3" value="CI2.3  Pisoteo y compactación de suelos someros por el ganado, con baja infiltración" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="579.4" y="905.5" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI3.1" value="CI3.1  Limitado conocimiento y organización comunal para el manejo del ecosistema y la gestión del riesgo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1086.7" y="783.0" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI3.2" value="CI3.2  Limitada gobernanza y articulación de las entidades públicas y privadas, con desconfianza por obras inconclusas" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1086.7" y="844.2" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI3.3" value="CI3.3  Alta informalidad en la tenencia de la tierra y presión de derechos mineros" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1086.7" y="905.5" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="e0" style="endArrow=block;dashed=1;html=0;strokeColor=#6B7A70;strokeWidth=1.5;" edge="1" parent="1" source="EX1" target="PC"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;dashed=1;html=0;strokeColor=#6B7A70;strokeWidth=1.5;" edge="1" parent="1" source="EX2" target="PC"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="CD1" target="PC"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="CD2" target="PC"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="CD3" target="PC"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0296;entryY=1;endArrow=none;" edge="1" parent="1" source="CI1.1" target="CD1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0296;entryY=1;endArrow=none;" edge="1" parent="1" source="CI1.2" target="CD1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0296;entryY=1;endArrow=none;" edge="1" parent="1" source="CI1.3" target="CD1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.029