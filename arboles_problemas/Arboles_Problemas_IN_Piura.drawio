 target="ED1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="PC" target="ED2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="PC" target="ED3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED1" target="EI1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED3" target="EI1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI1" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED1" target="EI2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI2" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED2" target="EI3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI3" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED2" target="EI4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ED3" target="EI4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#4A5A50;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;" edge="1" parent="1" source="EI4" target="EF"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ayabaca" name="Ayabaca"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1123" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Árbol de problemas – Provincia de Ayabaca (distrito de Frías) — Cuenca alta del río Piura · 10 bloques · 1,391.70 ha · 4 microcuencas · 17 centros poblados (2,541 hab., Censo 2017)" style="text;html=0;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#1B4D2E;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="43" y="24" width="1501" height="58" as="geometry"/></mxCell><mxCell id="EF" value="Incremento de los costos de reconstrucción y disminución de la resiliencia de la población de Frías y sus medios de vida frente a movimientos en masa e inundaciones desencadenados por lluvias extremas, intensificadas por el cambio climático" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#8C5A12;strokeColor=#8C5A12;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=21.7;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="328.4" y="100.8" width="930.6" height="87.6" as="geometry"/></mxCell><mxCell id="EI1" value="EI1  Daños a taludes y vías, viviendas, líneas de conducción de agua y tendido eléctrico; cortes de servicio en temporada de lluvias" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.0;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="43.2" y="228.7" width="359.4" height="91.2" as="geometry"/></mxCell><mxCell id="EI2" value="EI2  Pérdida de suelo productivo y de rendimiento de cultivos (maíz, frejol, café, palta, cacao) que sostienen a las familias" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.0;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="423.7" y="228.7" width="359.4" height="91.2" as="geometry"/></mxCell><mxCell id="EI3" value="EI3  Mayor aporte de sedimentos y colmatación de quebradas que drenan al valle del Alto Piura" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.0;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="804.2" y="228.7" width="359.4" height="91.2" as="geometry"/></mxCell><mxCell id="EI4" value="EI4  Pérdida de otros servicios del ecosistema: regulación hídrica de fuentes, hábitat de especies en peligro crítico y carbono" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FBF3E2;strokeColor=#C9A24F;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=17.0;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1184.8" y="228.7" width="359.4" height="91.2" as="geometry"/></mxCell><mxCell id="ED1" value="ED1  Mayor ocurrencia de movimientos en masa (desprendimientos, caídas de rocas y deslizamientos) en taludes, laderas y piedemonte" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F6E7C8;strokeColor=#B8862B;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="43.2" y="360.2" width="486.2" height="74.4" as="geometry"/></mxCell><mxCell id="ED2" value="ED2  Erosión hídrica acelerada y pérdida de suelo en laderas (surcos y cárcavas)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F6E7C8;strokeColor=#B8862B;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="550.6" y="360.2" width="486.2" height="74.4" as="geometry"/></mxCell><mxCell id="ED3" value="ED3  Mayor escorrentía superficial concentrada y carga de sedimentos desde las zonas de origen hacia las quebradas" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F6E7C8;strokeColor=#B8862B;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1057.9" y="360.2" width="486.2" height="74.4" as="geometry"/></mxCell><mxCell id="PC" value="La población de Frías (provincia de Ayabaca) no accede adecuadamente al servicio ecosistémico de regulación de riesgos naturales por la degradación del bosque estacionalmente seco y de los mosaicos agropecuarios de ladera en las zonas de origen de movimientos en masa e inundaciones" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1B4D2E;strokeColor=#1B4D2E;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=23.3;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="448.5" y="477.8" width="690.4" height="182.4" as="geometry"/></mxCell><mxCell id="EX1" value="Factores condicionantes del peligro
Pendiente media 57.5 % (64.6 % del área sobre 50 % y 204.37 ha sobre 75 %), la más fuerte del proyecto; susceptibilidad litológica a movimientos en masa alta en los 10 bloques; granito meteorizado (Súper Unidad Paltashaco)." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6B7A70;strokeWidth=1;fontColor=#5B6B61;fontFamily=Arial;fontSize=15.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="43.2" y="477.8" width="371.7" height="182.4" as="geometry"/></mxCell><mxCell id="EX2" value="Factor desencadenante y cambio climático
Lluvias de El Niño 1983, 1998 y 2023 entre 2.7 y 4.9 veces la media; abril 2023: 765–1,082 mm; 84 % de probabilidad de un año ≥ 2 veces la media en 20 años; Tmáx +0.21 a +0.25 °C por década." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6B7A70;strokeWidth=1;fontColor=#5B6B61;fontFamily=Arial;fontSize=15.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1172.5" y="477.8" width="371.7" height="182.4" as="geometry"/></mxCell><mxCell id="CD1" value="CD1  Degradación de la cobertura vegetal protectora en las zonas de origen" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0EA;strokeColor=#1B4D2E;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="43.2" y="703.4" width="486.2" height="52.8" as="geometry"/></mxCell><mxCell id="CD2" value="CD2  Reducida capacidad de los suelos y laderas para controlar la erosión y la escorrentía" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0EA;strokeColor=#1B4D2E;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="550.6" y="703.4" width="486.2" height="52.8" as="geometry"/></mxCell><mxCell id="CD3" value="CD3  Inadecuada gobernanza y gestión local del ecosistema y del riesgo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0EA;strokeColor=#1B4D2E;strokeWidth=2;fontColor=#1E2A22;fontFamily=Arial;fontSize=18.0;fontStyle=1;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1057.9" y="703.4" width="486.2" height="52.8" as="geometry"/></mxCell><mxCell id="CI1.1" value="CI1.1  Expansión de la agricultura de subsistencia de secano hacia laderas de fuerte pendiente" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="777.4" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI1.2" value="CI1.2  Tala y extracción selectiva de especies del bosque seco, incluidas especies en peligro crítico" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="838.6" width="457.4" height="68.4" as="geometry"/></mxCell><mxCell id="CI1.3" value="CI1.3  Pastoreo libre de vacunos y caprinos sin ordenamiento, que impide la regeneración natural" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="919.5" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI1.4" value="CI1.4  Baja capacidad de regeneración natural del bosque seco por aridez y alta variabilidad de las lluvias" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="72.0" y="980.8" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI2.1" value="CI2.1  Corredor vial y trochas con cortes de talud sin estabilización ni drenaje, que concentran la escorrentía" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="579.4" y="777.4" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI2.2" value="CI2.2  Laderas cultivadas sin prácticas de conservación de suelos (labranza a favor de la pendiente)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="579.4" y="838.6" width="457.4" height="68.4" as="geometry"/></mxCell><mxCell id="CI2.3" value="CI2.3  Cárcavas activas sin control que progresan en cabecera" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="579.4" y="919.5" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI3.1" value="CI3.1  Limitado conocimiento y organización comunal para el manejo del ecosistema y la gestión del riesgo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1086.7" y="777.4" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="CI3.2" value="CI3.2  Limitada presencia y articulación institucional, sin espacios de concertación, y desconfianza hacia agentes externos" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1086.7" y="838.6" width="457.4" height="68.4" as="geometry"/></mxCell><mxCell id="CI3.3" value="CI3.3  Tenencia comunal con posesión informal y linderos en disputa" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4F8F5;strokeColor=#7FA48C;strokeWidth=1;fontColor=#1E2A22;fontFamily=Arial;fontSize=16.3;fontStyle=0;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1086.7" y="919.5" width="457.4" height="48.8" as="geometry"/></mxCell><mxCell id="e0" style